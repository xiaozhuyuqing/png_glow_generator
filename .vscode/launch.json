{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 png_glow_generator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/png_glow_generator",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}
